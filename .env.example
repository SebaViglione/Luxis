# Copiar a .env.local y completar. Sin espacios después del "=", sin comillas, sin comentarios en la misma línea.

# Supabase (seba crea el proyecto y reparte los valores por mensaje privado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: seed demo y borrar cuenta
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (puerto 6543), lo usa la app
DATABASE_URL=
# Session pooler o conexión directa (puerto 5432), lo usa drizzle-kit
DIRECT_URL=

# IA
ANTHROPIC_API_KEY=
# Fallback opcional (IA_PROVEEDOR=google)
GOOGLE_GENERATIVE_AI_API_KEY=
IA_PROVEEDOR=anthropic

# Voz (stretch)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
